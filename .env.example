# Copy this file to .env and fill in your key.
# Get a key at https://console.anthropic.com/ (Settings -> API Keys).
ANTHROPIC_API_KEY=

# Optional: Google Books adds publisher descriptions/categories. Without a key it is
# often rate-limited and simply skipped. Free key: https://console.cloud.google.com/
GOOGLE_BOOKS_API_KEY=

# Optional overrides
# PORT=8000
# HOST=0.0.0.0           # 0.0.0.0 = reachable from other computers on your home network
# DWAB_DB=/path/to/dwab.db
# DWAB_MODEL=claude-opus-5-5
